<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/padding_horizontal_screen_dp">

        <TextView
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginBottom="@dimen/margin_8dp"
            android:text="@string/preview_your_id"
            android:textAppearance="@style/TextAppearance.Dojah.Header5" />

        <TextView
            android:id="@+id/step_indicator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginBottom="@dimen/margin_12dp"
            android:textAppearance="@style/TextAppearance.Dojah.ParagraphSmall"
            android:textColor="?attr/infoMessageColor"
            tools:text="Photo 1 of 3" />

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp">

                <ImageView
                    android:id="@+id/camera_preview"
                    android:layout_width="match_parent"
                    android:layout_height="289dp"
                    android:src="@color/card_stroke_color" />
            </androidx.cardview.widget.CardView>

            <LinearLayout
                android:id="@+id/processing"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:background="@drawable/processing_bg"
                android:gravity="center"
                android:paddingHorizontal="8dp"
                android:paddingVertical="6dp"
                android:visibility="gone"
                tools:visibility="visible">

                <com.dojah.kyc_sdk_kotlin.ui.utils.widget.DojahTextView
                    android:id="@+id/processing_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/margin_4dp"
                    android:drawableStart="@drawable/ic_processing"
                    android:gravity="center"
                    android:text="@string/processing_load"
                    android:textAppearance="@style/TextAppearance.Dojah.ParagraphSmall"
                    android:textColor="@color/primary" />
            </LinearLayout>
        </RelativeLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="@dimen/margin_16dp"
            android:layout_marginBottom="@dimen/margin_20dp"
            android:background="?attr/infoMessageCorneredBg"
            android:gravity="center">

            <TextView
                android:id="@+id/info_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginHorizontal="@dimen/margin_8dp"
                android:layout_marginTop="@dimen/margin_5dp"
                android:layout_marginBottom="@dimen/margin_4dp"
                android:drawablePadding="@dimen/margin_8dp"
                android:gravity="center"
                android:text="@string/building_photo_preview_instruction"
                android:textAlignment="center"
                android:textAppearance="@style/TextAppearance.Dojah.ParagraphTiny"
                android:textColor="?attr/infoMessageColor"
                app:drawableStartCompat="?attr/infoIcon"
                app:drawableTint="?attr/infoMessageColor" />
        </LinearLayout>

        <com.dojah.kyc_sdk_kotlin.ui.utils.widget.LoadingButton
            android:id="@+id/btn_continue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:buttonText="@string/_continue" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_retake"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_16dp"
            android:layout_marginBottom="@dimen/margin_16dp"
            android:text="@string/retake"
            android:textColor="@color/black"
            app:backgroundTint="@color/card_back_color"
            app:strokeColor="@color/black"
            app:strokeWidth="1dp" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>

